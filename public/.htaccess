# ---------------------------------------------------------------------------
# QueryReply AI — Apache / LiteSpeed config (Hostinger)
#
# The site is fully prerendered: every route ships its own index.html. So there
# is deliberately NO SPA catch-all rewrite here. The previous config sent every
# unknown path to index.html with a 200, which made the whole site one big soft
# 404 — /llms.txt, /this-page-does-not-exist and every typo all answered 200
# with the home page. Unknown paths now return a real 404.
# ---------------------------------------------------------------------------

Options -MultiViews

# mod_dir would 301 /pricing to /pricing/, fighting the canonical URLs.
DirectorySlash Off

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical origin: https, no www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://queryreply.ai%{REQUEST_URI} [R=301,L]

  # Canonical URLs carry no trailing slash: /pricing/ -> /pricing
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # Serve the prerendered page in place, with no redirect:
  #   /pricing -> pricing/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^.]+?)/?$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Vite fingerprints everything in /assets, so those are immutable;
# HTML and the crawler files must stay fresh or updates never reach anyone.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpe?g|svg|webp|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# Correct types for the crawler-facing files
# ---------------------------------------------------------------------------
AddType text/plain .txt
AddType application/xml .xml
AddDefaultCharset UTF-8
